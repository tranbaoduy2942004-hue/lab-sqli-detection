baseline_login_rejected = count_greater : 0 : ( _baseline )
sql_injection_bypass_verified = count_greater : 0 : ( _bypass )
webapp_audit_logs_verified = count_greater : 1 : ( _webfail, _websuccess )
soc_events_collected = count_greater : 1 : ( _socfail, _socsuccess )
soc_sqli_alert_confirmed = count_greater : 0 : ( _alert )
