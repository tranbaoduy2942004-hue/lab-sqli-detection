#!/usr/bin/env python3
import json, sqlite3, urllib.request
from pathlib import Path
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs

root = Path.home()/'lab09'
root.mkdir(exist_ok=True)
dbfile = root/'users.db'

with sqlite3.connect(dbfile) as db:
    db.execute("""
    CREATE TABLE IF NOT EXISTS users (
        username TEXT PRIMARY KEY,
        password TEXT,
        role TEXT
    )""")
    db.execute(
        "INSERT OR IGNORE INTO users VALUES (?,?,?)",
        ('labadmin','Lab09DemoPassword!','admin')
    )

class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != '/login':
            self.send_error(404)
            return

        n = int(self.headers.get('Content-Length',0))
        if not 0 < n <= 4096:
            self.send_error(400)
            return

        form = parse_qs(
            self.rfile.read(n).decode('utf-8','replace')
        )
        username = form.get('username',[''])[0]
        password = form.get('password',[''])[0]

        # Intentionally vulnerable SQL, for this isolated lab.
        query = (
            "SELECT username,role FROM users WHERE "
            f"username='{username}' AND password='{password}'"
        )

        try:
            with sqlite3.connect(dbfile) as db:
                row = db.execute(query).fetchone()
        except sqlite3.Error:
            row = None

        success = row is not None
        event = {
            'event': 'login_success' if success else 'login_failed',
            'ip': self.client_address[0],
            'username': username
        }

        with (root/'audit.log').open('a') as f:
            f.write(json.dumps(event)+'\n')

        try:
            request = urllib.request.Request(
                'http://172.29.109.30:8081/',
                data=json.dumps(event).encode(),
                headers={'Content-Type':'application/json'},
                method='POST'
            )
            urllib.request.urlopen(request,timeout=3).close()
        except Exception as exc:
            print('SOC_FORWARD_ERROR',str(exc),flush=True)

        response = {
            'authenticated': success,
            'role': row[1] if success else None,
            'record': 'LAB09_INTERNAL_TEST_RECORD'
                      if success else None
        }
        body = json.dumps(response).encode()
        self.send_response(200 if success else 401)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length',str(len(body)))
        self.end_headers()
        self.wfile.write(body)

print('LAB09_WEB_READY',flush=True)
ThreadingHTTPServer(('0.0.0.0',8080),Handler).serve_forever()
